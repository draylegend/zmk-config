#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV 1
#define NUM 2
#define SYM 3
#define ADJUST 4
#define GAME 5
#define LOL 6

/*
 * Physical layout of one half (see layout.md):
 *   5 columns x 3 rows, two centre keys (top, bottom) and three thumb keys.
 * Rows below are written as: left 5, left centre, right centre, right 5.
 *
 * Keycodes are positions on a German keyboard layout: Y and Z are swapped, SQT = Ä, SEMI = Ö,
 * LBKT = Ü, MINUS = ß, FSLH = "-", RBKT = "+", BSLH = "#", NON_US_BSLH = "<", RA() = AltGr.
 * The symbols of the SYM layer (and the "=" on NUM) are AltGr + key and need the two "Recto
 * symbols" Windows layouts from windows-layouts/ (German and Russian), where that plane is shared.
 */

/*
 * Space / NAV on one key: balanced, so NAV switches on the moment another key is tapped
 * while Space is held (arrow keys), and a fast roll "space, letter" still types a space.
 */
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };

    behaviors {
        /*
         * Home row mods (left hand only). Balanced: a key tapped and released while the
         * mod is still held (Ctrl+C, Shift+E, Ctrl+Right) makes it a modifier at once, no
         * waiting. A roll (the next key is still down when this one is released) stays a letter.
         * require-prior-idle-ms: right after another key it is always a letter, so fast
         * typing never fires a modifier. quick-tap-ms: tap then hold repeats the letter.
         */
        hrm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // Home row mods follow the order of a regular keyboard:
            //   left:  Ctrl . Alt Shift (A D F)    right: Shift Alt . Ctrl (J K ;), mirrored.
            //   Right Alt is LALT, not RALT: RALT is AltGr on a German layout.
            // Win: middle left thumb (Win+Shift+S: Win thumb, Shift F, S ring finger; all left hand).
            // Esc: above Tab (left centre keys). Left Alt (D) + Shift (F) held together switch the Windows language.
            bindings = <
                &kp Q            &kp W            &kp E            &kp R             &kp T &kp ESC  &kp BSPC &kp Y &kp U            &kp I            &kp O            &kp P
                &hrm LCTRL A     &kp S            &hrm LALT D      &hrm LSHFT F      &kp G &kp TAB   &kp RET &kp H &hrm RSHFT J       &hrm LALT K      &kp L            &hrm RCTRL SEMI
                &kp Z            &kp X            &kp C            &kp V             &kp B                &kp N &kp M             &kp COMMA        &kp DOT          &kp FSLH
                                                         &kp LA(LSHFT) &kp LGUI &lt NAV SPACE                         &mo SYM &mo NUM &mo ADJUST
            >;
        };

        nav_layer {
            display-name = "NAV";
            // Arrows as an inverted T on the right half; Ctrl/Alt/Shift on the left are
            // transparent, and so are the four centre keys (Tab, Win, Backspace, Enter).
            // Bottom row right: LBKT, SQT, RBKT = Х, Э, Ъ on the Russian layout (Ü, Ä, + on the German one).
            bindings = <
                &none      &none      &none      &none      &none &trans &trans &kp INS  &kp HOME &kp UP    &kp END   &kp DEL
                &trans     &trans     &trans     &trans     &none &trans &trans &kp CAPS &kp LEFT &kp DOWN  &kp RIGHT &kp PG_UP
                &none      &none      &none      &none      &none             &kp LBKT &kp SQT  &kp RBKT  &kp GRAVE  &kp PG_DN
                                                &none &trans &trans          &trans &trans &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            // Left: F1-F12 in reading order, then PrtSc, ScrLk, Pause.
            // Right: numpad block, "0" on the big inner thumb and "=" on the outer one (the
            // middle thumb is the NUM key itself, held). Operators to the right of the digits, from
            // the bottom up: * and / (bottom row), + and - (middle row). They are keypad keys, so
            // they type the same sign in the German and the Russian layout and ignore Shift.
            bindings = <
                &kp F1  &kp F2  &kp F3    &kp F4   &kp F5            &trans &trans   &kp N7 &kp N8 &kp N9 &none &none
                &kp F6  &kp F7  &kp F8    &kp F9   &kp F10           &trans &trans   &kp N4 &kp N5 &kp N6 &kp KP_PLUS &kp KP_MINUS
                &kp F11 &kp F12 &kp PSCRN &kp SLCK &kp PAUSE_BREAK                   &kp N1 &kp N2 &kp N3 &kp KP_ASTERISK &kp KP_SLASH
                                          &trans &trans &trans                       &kp N0 &trans &kp RA(N0)
            >;
        };

        sym_layer {
            display-name = "SYM";
            // Every sign is AltGr + key on a plane that is the SAME in the German and in the Russian
            // Windows layout (the "Recto symbols" layouts in windows-layouts/, see AGENTS-style notes
            // in layout.md), so the signs print the same in both languages. The AltGr key of a sign is
            // the BASE key at the same position: RA(Q) sits where Q is on BASE, and so on.
            // Brackets sit in the two inner columns of the left half, next to the centre keys. The
            // closer to the thumb, the more often they are used: { } bottom, [ ] middle, ( ) top;
            // < > bottom row, left of the curly pair.
            //   left:   ! ? ~ ( )    Ä Ö Ü [ ]    ß < > { }        centre: Tab, Win (transparent)
            //   (Ä Ö Ü and ß are plain keys: SQT = Ä, SEMI = Ö, LBKT = Ü, MINUS = ß on the German layout,
            //    Э Ж Х and "-" on the Russian one; capitals: hold Shift first, then SYM)
            //   (: ; _ are Shift + . , - on BASE, so they are not repeated here)
            //   right:  + EUR * / %    & | ^ \ @    ' " ` $ #
            bindings = <
                &kp RA(Q)   &kp RA(W)     &kp RA(E)     &kp RA(R)  &kp RA(T)   &trans    &trans &kp RA(Y)     &kp RA(U)           &kp RA(I)    &kp RA(O)   &kp RA(P)
                &kp SQT     &kp SEMI      &kp LBKT      &kp RA(F)  &kp RA(G)   &trans    &trans &kp RA(H)     &kp RA(J)           &kp RA(K)    &kp RA(L)   &kp RA(SEMI)
                &kp MINUS   &kp RA(X)     &kp RA(C)     &kp RA(V)  &kp RA(B)                    &kp RA(N)     &kp RA(M)           &kp RA(COMMA) &kp RA(DOT) &kp RA(FSLH)
                                                  &none &trans &none                           &trans &trans &trans
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            // Left half: media in a plus around Play (middle finger): Prev and Next on its sides,
            // Vol-, Mute, Vol+ under it; RGB on the top row.
            // Right half: top row game layers (Lol, GAME; free slots for other games), middle row
            // Bluetooth profiles 1-5, bottom row the technical keys, from the centre outwards, by
            // topic: connection (USB/BT switch, Bluetooth clear), Studio unlock, then the drastic
            // ones (reset, bootloader).
            bindings = <
                &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_EFF &rgb_ug RGB_HUI &none &none &tog LOL &tog GAME &none &none &none
                &none        &kp C_PREV   &kp C_PP     &kp C_NEXT   &none        &none &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &none        &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &none                   &out OUT_TOG &bt BT_CLR &studio_unlock &sys_reset &bootloader
                                                      &none &none &none                             &none &none &trans
            >;
        };

        game_layer {
            display-name = "GAME";
            // Any game: plain QWERTY on the left half, no hold-taps. Tab and Esc (the two left
            // centre keys) show through from BASE. Right half is off, except the top centre key
            // that leaves the layer.
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &trans   &tog GAME &none &none &none &none &none
                &kp A &kp S &kp D &kp F &kp G &trans   &none     &none &none &none &none &none
                &kp Z &kp X &kp C &kp V &kp B                   &none &none &none &none &none
                          &kp LCTRL &kp LSHFT &kp SPACE         &none &none &none
            >;
        };

        lol_layer {
            display-name = "LOL";
            // F1-F4 select the four allies (rebind them in the game; the camera on yourself is Space), 4 and 2 are item slots, Q W E R are the abilities.
            // GRAVE (the key left of 1, ^ on the German layout; "Attack only champions") is under the 2. Tab and Esc (the two left centre keys) show through from BASE.
            // The mouse hand reaches the top right corner: V (ward, the support key) alone in the corner.
            // Item 3 sits on the right big thumb key, P (the shop) on the middle right thumb key. The top centre key on the right leaves the layer.
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp N4 &trans   &tog LOL &none &none &none &none &kp V
                &kp Q  &kp W  &kp E  &kp R  &kp N2 &trans   &trans   &none &trans &none &none &none
                &kp A  &kp S  &kp D  &kp F  &kp GRAVE               &none &none &none &none &none
                         &kp LCTRL &kp LALT &kp SPACE               &kp N3 &kp P &none
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
